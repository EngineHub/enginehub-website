{
    "name": "paste",
    "private": true,
    "description": "EngineHub paste site, paste.enginehub.org",
    "version": "1.0.0",
    "author": "EngineHub",
    "type": "module",
    "dependencies": {
        "@enginehub/schematicjs": "^0.10.0",
        "@enginehub/schematicwebviewer": "^5.0.1",
        "@enginehub/shared": "workspace:*",
        "@google-cloud/storage": "^8.4.0",
        "base64-js": "^1.5.1",
        "next": "^16.4.6",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "sharp": "^0.35.5",
        "shortid": "^2.2.17"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/shortid": "^2.2.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "oxlint": "^1.93.0",
        "postcss-preset-env": "^11.6.2",
        "typescript": "^7.0.2"
    },
    "keywords": [
        "pastebin",
        "enginehub",
        "worldedit",
        "worldguard",
        "craftbook"
    ],
    "scripts": {
        "dev": "yarn next",
        "clean": "rm -rf build",
        "build": "yarn next build",
        "start": "yarn next start -p $PORT",
        "type-check": "yarn tsc --project ./tsconfig.json --noEmit",
        "lint": "oxlint src/ pages/",
        "lint:fix": "oxlint --fix src/ pages/"
    },
    "sideEffects": [
        "*.global.css"
    ]
}
