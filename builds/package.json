{
    "name": "builds",
    "private": true,
    "description": "EngineHub builds site, builds.enginehub.org",
    "version": "1.0.0",
    "author": "EngineHub",
    "type": "module",
    "dependencies": {
        "@enginehub/shared": "workspace:*",
        "@fortawesome/fontawesome-svg-core": "^7.3.1",
        "@fortawesome/free-solid-svg-icons": "^7.3.1",
        "@fortawesome/react-fontawesome": "^3.5.0",
        "moment": "^2.31.0",
        "next": "^16.4.6",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "sharp": "^0.35.5"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "oxlint": "^1.93.0",
        "postcss-preset-env": "^11.6.2",
        "typescript": "^6.0.3"
    },
    "keywords": [
        "nextjs",
        "enginehub",
        "worldedit",
        "worldguard",
        "craftbook"
    ],
    "scripts": {
        "dev": "yarn next",
        "clean": "rm -rf build",
        "build": "yarn next build",
        "start": "yarn next start -p $PORT",
        "type-check": "yarn tsc --project ./tsconfig.json --noEmit",
        "lint": "oxlint src/ pages/",
        "lint:fix": "oxlint --fix src/ pages/"
    }
}
