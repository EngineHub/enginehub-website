{
    "name": "@enginehub/shared",
    "private": true,
    "description": "Shared libs for the EngineHub sites",
    "version": "1.0.0",
    "author": "EngineHub",
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "type": "module",
    "devDependencies": {
        "@types/node": "^24.13.3",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "eslint": "^9.39.5",
