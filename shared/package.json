{
    "name": "@enginehub/shared",
    "private": true,
    "description": "Shared libs for the EngineHub sites",
    "version": "1.0.0",
    "author": "EngineHub",
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "type": "module",
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "oxlint": "^1.93.0",
        "schema-dts": "^2.1.0",
        "tslib": "^2.9.1",
        "typescript": "^6.0.3"
    },
    "keywords": [
        "enginehub",
        "worldedit",
        "worldguard",
        "craftbook"
    ],
    "scripts": {
