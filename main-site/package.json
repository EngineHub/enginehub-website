{
    "name": "main-site",
    "private": true,
    "description": "Main EngineHub website, enginehub.org",
    "version": "1.0.0",
    "author": "EngineHub",
    "type": "module",
    "dependencies": {
        "@enginehub/shared": "workspace:*",
        "next": "^16.4.6",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "sharp": "^0.35.5",
        "smooth-scroll": "^16.1.3"
    },
    "devDependencies": {
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "oxfmt": "^0.78.0",
        "oxlint": "^1.93.0",
        "postcss-preset-env": "^11.6.2",
        "typescript": "^6.0.3"
    },
    "keywords": [
        "gatsby",
        "enginehub",
        "worldedit",
        "worldguard",
        "craftbook"
    ],
    "scripts": {
        "build": "yarn next build",
        "dev": "yarn next dev",
        "format": "oxfmt --write src/**/*.{js,jsx}",
        "start": "yarn next start",
        "test": "echo \"Write tests!\"",
        "type-check": "yarn tsc --project ./tsconfig.json --noEmit",
        "lint": "oxlint src/ pages/",
        "lint:fix": "oxlint --fix src/ pages/"
    }
}
