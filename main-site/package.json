{
    "name": "main-site",
    "private": true,
    "description": "Main EngineHub website, enginehub.org",
    "version": "1.0.0",
    "author": "EngineHub",
    "type": "module",
    "dependencies": {
        "@enginehub/shared": "workspace:*",
        "next": "^16.3.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "sharp": "^0.35.3",
        "smooth-scroll": "^16.1.3"
    },
    "devDependencies": {
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "eslint": "^9.39.5",
        "postcss-preset-env": "^11.3.2",
        "prettier": "^3.9.6",
        "typescript": "^6.0.3"
    },
    "keywords": [
        "gatsby",
        "enginehub",
        "worldedit",
        "worldguard",
        "craftbook"
    ],
    "scripts": {
        "build": "yarn next build",
        "dev": "yarn next dev",
        "format": "yarn prettier --write src/**/*.{js,jsx}",
        "start": "yarn next start",
        "test": "echo \"Write tests!\"",
        "type-check": "yarn tsc --project ./tsconfig.json --noEmit",
        "lint": "eslint src/ pages/",
        "lint:fix": "yarn lint --fix"
    }
}
