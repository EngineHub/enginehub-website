{
    "name": "enginehub-websites",
    "private": true,
    "main": "index.js",
    "description": "EngineHub Websites",
    "version": "1.0.0",
    "author": "EngineHub",
    "type": "module",
    "workspaces": [
        "main-site",
        "builds",
        "paste",
        "golf",
        "shared"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/EngineHub/enginehub-website"
    },
    "dependencies": {
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "postinstall-postinstall": "^2.1.0"
    },
    "scripts": {
        "postinstall": "husky",
        "prepare": "husky",
        "precommit": "lint-staged",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "lint": "yarn workspaces foreach -A -pt --exclude enginehub-websites run lint",
        "lint:fix": "yarn workspaces foreach -A -pt --exclude enginehub-websites run lint:fix",
        "type-check": "yarn workspaces foreach -A -pt --exclude enginehub-websites run type-check"
    },
    "packageManager": "yarn@4.18.1",
    "devDependencies": {
        "oxfmt": "^0.78.0",
        "oxlint": "^1.93.0",
        "oxlint-tsgolint": "^7.0.2006",
        "typescript-plugin-css-modules": "^5.3.0"
    }
}
